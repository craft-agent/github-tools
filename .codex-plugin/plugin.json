{
  "name": "github-tools",
  "version": "0.12.0",
  "description": "GitHub tools for coding agents: issues, boards, pull requests, repositories, releases and Actions.",
  "author": {
    "name": "craftsamo",
    "url": "https://github.com/craftsamo"
  },
  "homepage": "https://github.com/craft-agent/github-tools#readme",
  "repository": "https://github.com/craft-agent/github-tools",
  "license": "LicenseRef-AGPL-3.0-Commons-Clause",
  "skills": "./skills",
  "mcpServers": {
    "github-tools": {
      "command": "node",
      "args": ["dist/mcp.js"],
      "cwd": ".",
      "default_tools_approval_mode": "writes",
      "env_vars": [
        "GITHUB_TOOLS_TOOLSETS",
        "GITHUB_TOOLS_READ_ONLY",
        "GITHUB_TOOLS_TOOLS",
        "GITHUB_TOOLS_EXCLUDE_TOOLS",
        "GITHUB_TOOLS_CONFIRM"
      ]
    }
  }
}
